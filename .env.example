# Your Mailtea API key: https://studio.mailtea.app/api-keys
# It needs contacts:read, contacts:write, issues:write and issues:send. Of the
# three presets in the key dialog only "Full access" carries all four —
# "Sending access" is the issues:* scopes alone, so it 403s on step 1.
MAILTEA_API_KEY=mt_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The publication this newsletter belongs to. Every audience call is scoped to
# one publication; find its id in Mailtea Studio under Settings -> Publication.
# Step 6 sends to this publication's whole active audience — see "Before you
# run this" in the README before pointing it at a live one.
MAILTEA_PUBLICATION_ID=pub_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# An address on a domain you have verified in Mailtea. Used for the TEST copy
# only: an audience send goes out as the publication's configured sender, so
# this address never reaches a subscriber.
MAILTEA_FROM=Acme <hello@acme.com>

# Where the test copy of the post goes. Not a subscriber — just you.
MAILTEA_TO=you@your-domain.com

# Optional. Overrides the API host, which defaults to https://api.mailtea.app.
# MAILTEA_API_BASE_URL=https://api.mailtea.app
